# Non-normative example for the target path docs/HARDWARE_CONTRACT.toml.
#
# The records below are synthetic placeholders, not reviewed device claims.
# Replace every placeholder value when copying this file. Retain a structural,
# vocabulary, or policy value only after confirming that it describes the local
# repository. The structure records interpreted claims and owner-review state;
# it does not verify silicon behavior, redistribution rights, or hardware
# qualification. The accompanying resource guide requires adoption review to
# reject every placeholder or sentinel, including REPLACE_WITH_* values and
# example.invalid identities below.
#
# This example does not define a shared schema. A repository may add and version
# its own format only when a machine consumer needs a compatibility contract.
#
# Markdown checkboxes are a poor owner-review encoding. GitHub-flavored
# `[ ]` cannot mean both "not yet reviewed" and "reviewed, sources silent."
# Use an explicit `review` string on every row.

reviewed_utc = "YYYY-MM-DD"
sources_registry = "docs/SOURCES.toml"
default_identity = "example-ex1234-ref-afe"

# Allowed `review` values in this example:
# - "declared": repository-owned decision; binding for this repository without
#   vendor-source verification
# - "provisional": recorded, not yet owner-reviewed; no claim either way
# - "confirmed": owner reviewed against pinned sources and accepted
# - "omission": owner reviewed; the sources do not state the fact. The absence
#   is the finding.
#
# Allowed `provenance` values in this example:
# - "repository-declaration"
# - "vendor-source"

[[row]]
id = "example-default-afe-identity"
section = "named-reference-afe"
review = "declared"
provenance = "repository-declaration"
claim = "The only implied default transfer identity is example-ex1234-ref-afe."
value = "example-ex1234-ref-afe"
notes = "Synthetic placeholder; replace with the local named identity. Repository declarations are binding without a vendor-source checkbox."

[[row]]
id = "example-load-and-adc"
section = "named-reference-afe"
review = "declared"
provenance = "repository-declaration"
claim = "The reference analog front-end uses REPLACE_WITH_LOAD, REPLACE_WITH_VREF, and ADC maximum code REPLACE_WITH_MAX_CODE."
notes = "Synthetic placeholder; replace with the assembled-circuit fields the first transfer will use."

[[row]]
id = "example-nominal-photocurrent"
section = "photocurrent"
review = "provisional"
provenance = "vendor-source"
source = "example-ex1234-datasheet-r1_0"
claim = "Typical photocurrent is REPLACE_WITH_NOMINAL at the named test condition."
notes = "Synthetic placeholder; owner review is required before treating this vendor-source row as accepted."

[[row]]
id = "example-confirmed-register-width"
section = "device-interface"
review = "confirmed"
provenance = "vendor-source"
source = "example-ex1234-datasheet-r1_0"
claim = "The example output word is REPLACE_WITH_WIDTH bits."
notes = "Synthetic placeholder illustrating a confirmed vendor-source row after owner review."

[[row]]
id = "example-omission-undocumented-clear"
section = "device-interface"
review = "omission"
provenance = "vendor-source"
source = "example-ex1234-datasheet-r1_0"
claim = "The sources state no flag-clearing contract for REPLACE_WITH_STATUS_FIELD."
notes = "Synthetic placeholder illustrating a reviewed silence. Do not encode this as an unchecked markdown box."
