# Non-normative example for the target path docs/SOURCES.toml.
#
# The records below are synthetic placeholders, not reviewed source identities.
# Replace every placeholder value when copying this file. Retain a structural,
# vocabulary, or policy value only after confirming that it describes the local
# repository. The structure identifies source bytes and their local role; it
# does not verify interpretations, redistribution rights, silicon behavior, or
# hardware qualification. Add a source only when a current proposition or
# another real integrity or rights consumer cites it. Source IDs are not
# proposition IDs. The accompanying resource guide recommends checking and
# replacing every placeholder or sentinel, including the zero byte counts and
# non-hex digests below.
#
# This example does not define a shared schema. A repository may add and version
# its own format only when a machine consumer needs a compatibility contract.

redistribution_policy = "metadata-only"

[[source]]
id = "example-ex1234-datasheet-r1_0"
status = "active"
kind = "datasheet"

publisher = "Example Semiconductor"
title = "EX1234 Ambient Light Sensor"
document = "EX1234-DS"
revision = "1.0"
published = "YYYY-MM-DD"
applies_to = ["EX1234"]

landing_url = "https://example.invalid/products/ex1234"
artifact_url = "https://example.invalid/docs/ex1234-datasheet.pdf"
retrieved_utc = "YYYY-MM-DD"
media_type = "application/pdf"
bytes = 0
sha256 = "REPLACE_WITH_64_LOWERCASE_HEX_DIGITS"

# Allowed values in this example are "not-established", "permitted", and
# "prohibited". This describes the reviewed rights posture, not whether a copy
# happens to be present.
redistribution = "not-established"
notes = "Synthetic placeholder; replace with the review note for the exact local artifact."

# For a later exact revision, add a new active entry instead of silently
# replacing the old identity. A proposition records how each relevant source
# bears on it; this registry does not choose a global winner. Optional
# relationship fields may be used once a real consumer needs them:
#
# supersedes = "vendor-document-older-revision"
# superseded_by = "vendor-document-newer-revision"
